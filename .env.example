# PostgreSQL password for the Strapi database
POSTGRES_PASSWORD=your_postgres_password

# Strapi application keys (comma-separated, generated via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
STRAPI_APP_KEYS=key1,key2,key3,key4

# Strapi API token salt (used for API token hashing inside Strapi)
STRAPI_API_TOKEN_SALT=your_strapi_api_token_salt

# Strapi JWT secret (used for admin panel authentication)
STRAPI_JWT_SECRET=your_strapi_jwt_secret

# Worker runtime credential: a real API token generated in the Strapi admin panel
STRAPI_API_TOKEN=your_worker_api_token

# Public URL of the Strapi instance (used at Vite build time)
VITE_STRAPI_URL=http://localhost:1337

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
