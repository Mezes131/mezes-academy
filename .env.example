# PostgreSQL password for the Strapi database
POSTGRES_PASSWORD=your_postgres_password

# Strapi application keys (comma-separated, generated via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
STRAPI_APP_KEYS=key1,key2,key3,key4

# Strapi API token salt (used for API token hashing inside Strapi)
STRAPI_API_TOKEN_SALT=your_strapi_api_token_salt

# Strapi JWT secret (users-permissions plugin)
STRAPI_JWT_SECRET=your_strapi_jwt_secret

# Strapi admin panel JWT secret
STRAPI_ADMIN_JWT_SECRET=your_strapi_admin_jwt_secret

# Strapi transfer token salt (data transfer encryption)
STRAPI_TRANSFER_TOKEN_SALT=your_strapi_transfer_token_salt

# Strapi encryption key (field-level encryption)
STRAPI_ENCRYPTION_KEY=your_strapi_encryption_key

# Worker runtime credential: a real API token generated in the Strapi admin panel
STRAPI_API_TOKEN=your_worker_api_token

# Public URL of the Strapi instance (used at Vite build time)
VITE_STRAPI_URL=http://localhost:1337

# When true, course pages load published content from Strapi (else static TS)
VITE_STRAPI_CONTENT_ENABLED=false

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only (worker): never expose to Vite / browser
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_URL=https://your-project.supabase.co

# MinIO (lesson video storage — docker compose minio service)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
