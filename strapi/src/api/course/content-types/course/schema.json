{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "Top-level published course catalogue entry"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "legacyId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "iconFamily": {
      "type": "enumeration",
      "enum": ["fa-solid", "fa-brands"]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "level": {
      "type": "enumeration",
      "enum": ["intro", "beginner", "intermediate", "advanced", "expert"]
    },
    "duration": {
      "type": "string"
    },
    "accentText": {
      "type": "string"
    },
    "accentBg": {
      "type": "string"
    },
    "accentBorder": {
      "type": "string"
    },
    "workflowStatus": {
      "type": "enumeration",
      "enum": ["draft", "review", "published", "archived"],
      "default": "draft"
    },
    "phases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::phase.phase",
      "mappedBy": "course"
    }
  }
}
