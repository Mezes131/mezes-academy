{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "legacyId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "desc": {
      "type": "text"
    },
    "objective": {
      "type": "text"
    },
    "duration": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "isRequired": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "json"
    },
    "outline": {
      "type": "json"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "lesson.text-block",
        "lesson.code-block",
        "lesson.callout-block",
        "lesson.video-block",
        "lesson.image-block",
        "lesson.exercise-block",
        "lesson.checklist-block"
      ]
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "lessons"
    },
    "quiz": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::quiz.quiz",
      "mappedBy": "lesson"
    },
    "exercises": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exercise.exercise",
      "mappedBy": "lesson"
    },
    "resources": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::resource.resource",
      "mappedBy": "lessons"
    }
  }
}
