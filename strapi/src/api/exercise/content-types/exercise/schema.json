{
  "kind": "collectionType",
  "collectionName": "exercises",
  "info": {
    "singularName": "exercise",
    "pluralName": "exercises",
    "displayName": "Exercise"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "legacyId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "instructions": {
      "type": "text"
    },
    "kind": {
      "type": "enumeration",
      "enum": ["guided", "synthesis", "project", "audit", "reflection", "code"]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "hints": {
      "type": "json"
    },
    "starterFiles": {
      "type": "json"
    },
    "solutionFiles": {
      "type": "json",
      "private": true
    },
    "tests": {
      "type": "json",
      "private": true
    },
    "validator": {
      "type": "text",
      "private": true
    },
    "template": {
      "type": "enumeration",
      "enum": ["react", "react-ts", "vanilla"]
    },
    "attemptsBeforeSolution": {
      "type": "integer",
      "default": 5
    },
    "challengeEligible": {
      "type": "boolean",
      "default": true
    },
    "validationMode": {
      "type": "enumeration",
      "enum": ["local", "instructor", "automated"],
      "default": "local"
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "exercises"
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "exercises"
    }
  }
}
