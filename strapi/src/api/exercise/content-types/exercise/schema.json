{
  "kind": "collectionType",
  "collectionName": "exercises",
  "info": {
    "singularName": "exercise",
    "pluralName": "exercises",
    "displayName": "Exercise"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "legacyId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "instructions": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "guided",
        "synthesis",
        "project",
        "audit",
        "reflection",
        "code"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "hints": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "starterFiles": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "solutionFiles": {
      "type": "json",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tests": {
      "type": "json",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "validator": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "template": {
      "type": "enumeration",
      "enum": [
        "react",
        "react-ts",
        "vanilla"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "attemptsBeforeSolution": {
      "type": "integer",
      "default": 5
    },
    "challengeEligible": {
      "type": "boolean",
      "default": true
    },
    "validationMode": {
      "type": "enumeration",
      "enum": [
        "local",
        "instructor",
        "automated"
      ],
      "default": "local",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "exercises"
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "exercises"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
