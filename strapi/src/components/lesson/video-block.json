{
  "collectionName": "components_lesson_video_blocks",
  "info": {
    "displayName": "Video Block",
    "icon": "play"
  },
  "attributes": {
    "provider": {
      "type": "enumeration",
      "enum": ["mux", "vimeo", "bunny", "youtube", "minio", "other"],
      "default": "other"
    },
    "providerId": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "integer"
    },
    "transcript": {
      "type": "text"
    },
    "access": {
      "type": "enumeration",
      "enum": ["free", "premium"],
      "default": "premium"
    },
    "posterUrl": {
      "type": "string"
    },
    "mimeType": {
      "type": "string"
    }
  }
}
